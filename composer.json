{
    "name": "cmi-solutions/prestashop-cmi",
    "description": "CMI (Morocco) card payment module for PrestaShop 9",
    "type": "prestashop-module",
    "license": "AFL-3.0",
    "authors": [
        {
            "name": "CMI"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "prestashop/php-dev-tools": "^5.0",
        "phpstan/phpstan": "^1.12",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "Cmi\\PrestaShop\\": "src/"
        }
    },
    "config": {
        "prepend-autoloader": false
    },
    "scripts": {
        "test": "php tests/run-tests.php",
        "i18n": "php tools/i18n-check.php",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse --no-progress"
    }
}
